# Maintainer: Ahmad Teeb <ahmadteeb>
pkgname=bulkhead-bin
pkgver=1.0.0
pkgrel=1
pkgdesc="State-of-the-art Flutter Docker Engine Manager for Linux"
arch=('x86_64')
url="https://github.com/ahmadteeb/Bulkhead"
license=('MIT')
depends=('gtk3' 'docker')
provides=('bulkhead')
conflicts=('bulkhead')
source=("${url}/releases/download/v${pkgver}/bulkhead-linux-x64.zip")
sha256sums=('SKIP')

package() {
    install -dm755 "${pkgdir}/opt/bulkhead"
    cp -r "${srcdir}"/* "${pkgdir}/opt/bulkhead/"
    chmod +x "${pkgdir}/opt/bulkhead/bulkhead"

    install -dm755 "${pkgdir}/usr/bin"
    ln -s "/opt/bulkhead/bulkhead" "${pkgdir}/usr/bin/bulkhead"

    install -dm755 "${pkgdir}/usr/share/applications"
    cat <<EOF > "${pkgdir}/usr/share/applications/bulkhead.desktop"
[Desktop Entry]
Name=Bulkhead
Comment=Flutter Docker Manager for Linux
Exec=/usr/bin/bulkhead
Icon=/opt/bulkhead/data/flutter_assets/assets/icon.png
Terminal=false
Type=Application
Categories=Development;System;
EOF
}
